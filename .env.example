# Database (Postgres — Docker in dev, Neon in prod)
# Dev-only default credentials: the password must match POSTGRES_PASSWORD in
# docker-compose.dev.yml (override it via the POSTGRES_PASSWORD env var).
# If you override POSTGRES_PASSWORD, update the password inside DATABASE_URL
# too — compose reads the former, the app connects with the latter, and a
# mismatch means the app cannot authenticate (cubic pr10 env:5).
# Init-only: on an existing volume the DB keeps its old password — rotate
# with ALTER USER or reset the volume (see docker-compose.dev.yml).
# Never ship the default password anywhere reachable beyond localhost.
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/openbizcrm
# Driver override: postgres (local/Docker) or neon (serverless). Unset = auto by URL host.
DB_DRIVER=

# Auth (WorkOS)
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Used to encrypt the auth session cookie; must be at least 32 characters
WORKOS_COOKIE_PASSWORD=
# Exact post-sign-in redirect URI registered in WorkOS (path must be /api/auth/callback)
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Dev/test ONLY: 1 = in-memory fake sessions without WorkOS. NEVER enable in production.
AUTH_FAKE=

# App
# Public base URL of this deployment. Dev default below; production MUST be https.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare R2 (cloud drive file storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=openbizcrm
# Optional S3-compatible endpoint override (e.g. local MinIO); unset = Cloudflare R2 default
# S3_ENDPOINT=

# Ably (realtime chat and presence)
ABLY_API_KEY=

# Local LLM gateway (dev only)
# MUST be https outside local dev: chat history and org aggregates are POSTed to it verbatim.
AI_GATEWAY_URL=

# WhatsApp + AI (track ini)
# AI_GATEWAY_URL: endpoint OpenAI-compatible (wajib untuk fitur AI chat)
AI_GATEWAY_MODEL=gpt-4o-mini
# WhatsApp worker (bun src/lib/whatsapp/worker.ts)
WORKER_USER_ID=
WORKER_ORG_ID=
